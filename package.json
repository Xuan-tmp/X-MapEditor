{
  "name": "local-map-editor",
  "version": "0.102.1",
  "description": "本地地图编辑器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.2"
  },
  "build": {
    "appId": "com.local.mapeditor",
    "productName": "地图编辑器",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "main.js",
      "preload.js",
      "projects/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
